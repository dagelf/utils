#!/bin/sh -e

if [ $# -lt 1 ]; then
    cat << HELP

dockertags  --  list all tags for a Docker image on Docker Hub.

EXAMPLE:
    - list all tags for ubuntu:
       dockertags ubuntu

    - list all php tags containing apache:
       dockertags php apache

HELP
    exit 1
fi

image="$1"
# Official images live under library/
case "$image" in */*) ;; *) image="library/$image" ;; esac

# Hub caps page_size at 100 and anonymous paging at 10 pages (1000 tags),
# so filter server-side with name= and follow "next" until it's null
url="https://hub.docker.com/v2/repositories/${image}/tags?page_size=100&name=${2:-}"
while [ -n "$url" ]; do
    page=$(curl -fsS "$url") || { echo "dockertags: stopped at $url (404: no such image; 403: past Hub's 1000-tag limit, narrow the filter)" >&2; exit 1; }
    echo "$page" | grep -o '"name":"[^"]*"' | cut -d'"' -f4
    url=$(echo "$page" | grep -o '"next":"[^"]*"' | cut -d'"' -f4 | sed 's/\\u0026/\&/g')
done
