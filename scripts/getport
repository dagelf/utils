#!/usr/bin/env python3
"""Allocate a port, or retrieve a named allocation: getport [name]."""

# Missing capability: persistent port allocation serialized across CLI callers.
import contextlib
import errno
import os
from pathlib import Path
import socket
import sqlite3
import sys


def available(port):
    with contextlib.ExitStack() as sockets:
        for family, address in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
            for kind in (socket.SOCK_STREAM, socket.SOCK_DGRAM):
                try:
                    sock = sockets.enter_context(socket.socket(family, kind))
                    if family == socket.AF_INET6:
                        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                    sock.bind((address, port))
                except OSError as exc:
                    if family == socket.AF_INET6 and exc.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL):
                        break
                    if exc.errno == errno.EADDRINUSE:
                        return False
                    raise
        return True


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and not sys.argv[1]):
        print("Usage: getport [name]", file=sys.stderr)
        return 2
    name = sys.argv[1] if len(sys.argv) == 2 else None
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dagelf-utils"
    state.mkdir(parents=True, exist_ok=True)
    with contextlib.closing(sqlite3.connect(state / "ports.sqlite3", timeout=30)) as db:
        with db:
            db.execute("BEGIN IMMEDIATE")
            db.execute("CREATE TABLE IF NOT EXISTS ports (port INTEGER PRIMARY KEY, name TEXT UNIQUE)")
            row = db.execute("SELECT port FROM ports WHERE name = ?", (name,)).fetchone()
            if row:
                port = row[0]
            else:
                port = db.execute("SELECT COALESCE(MAX(port), 9999) + 1 FROM ports").fetchone()[0]
                while port <= 65535 and not available(port):
                    port += 1
                if port > 65535:
                    raise RuntimeError("no available ports remain")
                db.execute("INSERT INTO ports (port, name) VALUES (?, ?)", (port, name))
        print(port)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, sqlite3.Error, RuntimeError) as exc:
        print(f"getport: {exc}", file=sys.stderr)
        sys.exit(1)
