#!/usr/bin/env python3
"""Allocate a port, or retrieve a named allocation: getport [name]."""

# Missing capability: persistent port allocation serialized across CLI callers.
import contextlib
import errno
import itertools
import os
from pathlib import Path
import socket
import sqlite3
import subprocess
import sys


def caller_name():
    """Use the parent command, or its script name for common interpreters."""
    parent = Path(f"/proc/{os.getppid()}")
    args = [os.fsdecode(arg) for arg in (parent / "cmdline").read_bytes().split(b"\0") if arg]
    if not args:
        return (parent / "comm").read_text().strip()
    command = Path(args[0]).name.lstrip("-")
    if command in ("sh", "bash", "dash", "zsh", "ksh", "fish", "node", "ruby", "perl") or command.startswith("python"):
        for arg in args[1:]:
            if arg in ("-c", "-m"):
                break
            if not arg.startswith("-"):
                return Path(arg).name
    return command


def available(port):
    with contextlib.ExitStack() as sockets:
        for family, address in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
            for kind in (socket.SOCK_STREAM, socket.SOCK_DGRAM):
                try:
                    sock = sockets.enter_context(socket.socket(family, kind))
                    if family == socket.AF_INET6:
                        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                    sock.bind((address, port))
                except OSError as exc:
                    if family == socket.AF_INET6 and exc.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL):
                        break
                    if exc.errno == errno.EADDRINUSE:
                        return False
                    raise
        return True


def main():
    lookup = len(sys.argv) > 1 and sys.argv[1] == "--lookup"
    args = sys.argv[2:] if lookup else sys.argv[1:]
    if len(args) > 1 or (lookup and not args) or (args and not args[0]):
        print("Usage: getport [name] | getport --lookup name", file=sys.stderr)
        return 2
    name = args[0] if args else None
    caller = caller_name() if name is None else None
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dagelf-utils"
    if lookup:
        database = state / "ports.sqlite3"
        if not database.exists():
            return 1
        with contextlib.closing(sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True)) as db:
            row = db.execute("SELECT port FROM ports WHERE name = ?", (name,)).fetchone()
        if not row:
            return 1
        print(row[0])
        return 0
    state.mkdir(parents=True, exist_ok=True)
    with contextlib.closing(sqlite3.connect(state / "ports.sqlite3", timeout=30)) as db:
        with db:
            db.execute("BEGIN IMMEDIATE")
            db.execute("CREATE TABLE IF NOT EXISTS ports (port INTEGER PRIMARY KEY, name TEXT UNIQUE)")
            db.execute("CREATE TABLE IF NOT EXISTS free_ports (port INTEGER PRIMARY KEY)")
            row = db.execute("SELECT port FROM ports WHERE name = ?", (name,)).fetchone()
            if row:
                port = row[0]
                listeners = subprocess.run(["ss", "-H", "-lntu", f"sport = :{port}"], capture_output=True, text=True, check=True).stdout
                if not listeners.strip():
                    db.execute("DELETE FROM ports WHERE port = ?", (port,))
                    db.execute("INSERT OR IGNORE INTO free_ports VALUES (?)", (port,))
                    return 1
            else:
                start = db.execute("SELECT COALESCE(MAX(port), 9999) + 1 FROM (SELECT MAX(port) AS port FROM ports UNION ALL SELECT MAX(port) FROM free_ports)").fetchone()[0]
                recycled = (row[0] for row in db.execute("SELECT port FROM free_ports ORDER BY port"))
                for port in itertools.chain(recycled, range(start, 65536)):
                    allocated_name = name if name is not None else f"{caller}:{port}"
                    if not db.execute("SELECT 1 FROM ports WHERE name = ?", (allocated_name,)).fetchone() and available(port):
                        break
                else:
                    raise RuntimeError("no available ports remain")
                db.execute("INSERT INTO ports (port, name) VALUES (?, ?)", (port, allocated_name))
                db.execute("DELETE FROM free_ports WHERE port = ?", (port,))
        if caller is not None:
            print(f"getport: {allocated_name}", file=sys.stderr)
        elif row:
            scheme = "tcp" if any(line.startswith("tcp") for line in listeners.splitlines()) else "udp"
            print(f"{scheme}://127.0.0.1:{port}", file=sys.stderr)
        print(port)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, sqlite3.Error, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"getport: {exc}", file=sys.stderr)
        sys.exit(2)
