#!/usr/bin/env python3
"""Feed a desktop password first, then relay terminal input for trust prompts."""
import os
import shutil
import subprocess
import sys
import threading


password = os.environ.pop("DESKTOP_PASSWORD")
with open("/dev/tty", "rb", buffering=0) as tty:
    with subprocess.Popen(sys.argv[1:], stdin=subprocess.PIPE, bufsize=0) as child:
        def feed():
            try:
                child.stdin.write((password + "\n").encode())
                shutil.copyfileobj(tty, child.stdin)
            except (BrokenPipeError, ValueError):
                pass
            finally:
                child.stdin.close()

        # Waiting on the child ends the relay, even while terminal input blocks.
        threading.Thread(target=feed, daemon=True).start()
        try:
            status = child.wait()
        except KeyboardInterrupt:
            child.terminate()
            child.wait()
            status = 130
sys.exit(status if status >= 0 else 128 - status)
