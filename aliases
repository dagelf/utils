HISTCONTROL=ignoredups:erasedups

# ssh-agent: reuse a running one, else start one
mkdir -p ~/.ssh/agent
[ -r ~/.ssh/agent/rc ] && . ~/.ssh/agent/rc >/dev/null && [ -S "$SSH_AUTH_SOCK" ] && kill -0 "$SSH_AGENT_PID" 2>/dev/null || { ssh-agent > ~/.ssh/agent/rc && . ~/.ssh/agent/rc >/dev/null; }

function a () {(for a in $SERVERS; do ssh $a $*|sed "s/^/$a: /"&done|sort -k1;wait;)};  # run a command on all $SERVERS in parallel and sort output
