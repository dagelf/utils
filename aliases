# Sourced from ~/.bashrc by install.sh. Machine-specific vars (SERVERS, RES, WIN_USER, WIN_PASS) go in ~/.bashrc before the hook.
U="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case ":$PATH:" in *":$U/scripts:"*) ;; *) PATH="$U/scripts:$PATH" ;; esac

