# serve current dir: hostthis1 = open, hostthis = basic auth (user admin)
alias caddy-server='caddy file-server --listen :2015 --root . --browse'
function hostthis1 () { caddy file-server --root . --browse --listen ":${1:-2080}"; }
function hostthis () {
  local p h; read -rsp "Password for admin: " p; echo
  h="$(caddy hash-password --plaintext "$p")" || return
  caddy run --adapter caddyfile --config <(printf ':%s {\n\troot * %s\n\tbasic_auth * {\n\t\tadmin %s\n\t}\n\tfile_server browse\n}\n' "${1:-2080}" "$PWD" "$h")
}

