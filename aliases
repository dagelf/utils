# desktop
# Missing capability: close this shell after a short wait unless any key is pressed.
# Foreground only; leave the cancelling key queued for the normal shell prompt.
function idle_exit () {
  [[ $- == *i* && -t 0 ]] || return 0
  python3 - "${1:-5}" <<'PY'
import select
import sys
import termios

with open('/dev/tty', 'rb', buffering=0) as tty:
    original = termios.tcgetattr(tty)
    watching = termios.tcgetattr(tty)
    watching[3] &= ~(termios.ICANON | termios.ECHO)
    try:
        termios.tcsetattr(tty, termios.TCSANOW, watching)
        active = bool(select.select([tty], [], [], float(sys.argv[1]))[0])
    finally:
        termios.tcsetattr(tty, termios.TCSANOW, original)
sys.exit(1 if active else 0)
PY
  if [[ $? == 0 ]]; then exit; fi
}
