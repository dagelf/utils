function findlibwith () { [ -e /tmp/findlibs ] || find /lib /usr/lib /usr/local/lib -type f -name '*.a' -printf '%p:' -exec sh -c 'echo $(objdump -x "$1")' _ {} \; 2>/dev/null > /tmp/findlibs; grep "$1" /tmp/findlibs | cut -d: -f1; }
function matchn () { [ -z "$3" ] && { echo "matchn file [match n]... # output line n after match"; return 1; }; local f=$1 s=; shift; while [ -n "$2" ]; do s="$s/$1/{c=$2};"; shift 2; done; awk 'c&&!--c;'"$s" "$f"; }
function waitall () { [ -z "$1" ] && { echo "waitall string # wait until all current processes matching string exit"; return 1; }; for a in $(pgrep -f "$1"); do while [ -e /proc/$a ]; do sleep 1; done; done; }
function mrec () { cnee --record -o /tmp/events.xnr --mouse --events-to-record 50000 --time 2; }
function mplay () { sleep 1.9; while sleep 0.1; do cnee --replay -f /tmp/events.xnr --time 0; done; }
function md () { local t=$(mktemp --suffix=.html); { echo '<style>html,body{background:#000;color:#fff}</style>'; markdown < "$1"; } > "$t"; firefox "$t"; }  # dark markdown viewer
function rbench () { local d=${1:-/temp} len=${2:-100} s a; for s in 1024 512 256 128 64 16 8 4 1; do a=$((s*1024)); echo -ne "${s}k\t"; sync; echo 3|sudo tee /proc/sys/vm/drop_caches >/dev/null; nice -10 sudo dd if=$d of=/dev/null bs=$a count=$((len*1024*1024/a)) 2>&1|grep -v records; done; }  # read benchmark: rbench [dev] [MB]
function smartlog () { local d=$(date +%s) a s; sudo mkdir -p /var/lib/smart; sudo chmod a+rw /var/lib/smart; for a in $(cd /dev; ls sd?); do sudo smartctl --all /dev/$a > /tmp/$a-tmp; s=$(grep 'Serial N' /tmp/$a-tmp|cut -d: -f2|tr -d ' '); mv /tmp/$a-tmp /var/lib/smart/$s-$d; done; }
function clean () { sudo killall bc ping rdesktop; sudo ps -aelf|grep bash|grep poll_s|sudo awk '{system("kill "$4)}'; }  # kill idle bash prompts and common clutter
function ww () { for a in $(sudo iwlist ${WLAN:-wlan0} scanning $1|egrep "(Qua|Enc|ESSID)"|sed s@=@\ @g); do echo -n "$a "; echo $a|grep -q Qua&&echo; done|sed s@Quality@@g|sort -n -k5; }
function dxr () { [ -z "$2" ] && { echo "dxr image command # docker run with X"; return 1; }; docker run --init -v /tmp/.X11-unix/X0:/tmp/.X11-unix/X0 -e DISPLAY=$DISPLAY "$@"; }
function dip () { docker inspect $(docker ps -aq) | jq -r '["IP", "CONTAINER ID", "NAME", "PORTS"], (.[] | [([.NetworkSettings.Networks[]?.IPAddress] | map(select(. != "")) | unique | join(",")), .Id[0:12], (.Name | ltrimstr("/")), ([((.NetworkSettings.Ports // {}) | to_entries[]) | .key as $port | if (.value | length) > 0 then .value[] | "\(.HostIp):\(.HostPort)->\($port)" else $port end] | join(", "))] | map(if . == "" then "-" else . end)) | @tsv' | column -t -s "$(printf '\t')"; }  # container IPs, names, ports
function sk () { [ -z "$1" ] && { echo "sk host [ssh options] # add your ssh key to host"; return 1; }; [ -f ~/.ssh/id_rsa ] || ssh-keygen; local K=$(cat ~/.ssh/id_rsa.pub); ssh "$@" "mkdir -p .ssh;grep -q \"$K\" .ssh/authorized_keys||echo \"$K\" >> .ssh/authorized_keys;chmod 600 .ssh/authorized_keys" >/dev/null 2>&1; }
function github-new () { local T U; read -rsp "Paste github token: " T; echo; U=$(curl -s -X POST -H "Authorization: token $T" https://api.github.com/user/repos -d "{\"name\":\"${PWD##*/}\"}" | jq -r .clone_url) && git remote add origin "$U" && git push --set-upstream origin main; }
function nct () { local t=$(mktemp -u); mkfifo $t; cat $t | /bin/sh -i 2>&1 | nc -l ${1:-4444} > $t; rm $t; }  # shell on a port
function nctty () { reset; export SHELL=/bin/bash TERM=xterm; stty rows 25 columns 80; }

