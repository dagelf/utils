# network
# Terminate TCP listeners on one or more ports: lsofkill 3000 :8080
function lsofkill () {
  (($#)) || { echo 'Usage: lsofkill port [port ...]' >&2; return 2; }
  local port records status pid line ports=()
  for port in "$@"; do
    port=${port#:}
    [[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || { echo "Invalid port: $port" >&2; return 2; }
    ports+=("-iTCP:$port")
  done
  records=$(lsof -nP -Fpc -a "${ports[@]}" -sTCP:LISTEN); status=$?
  ((status <= 1)) || return "$status"
  status=0
  while IFS= read -r line; do
    case $line in
      p*) pid=${line#p} ;;
      c*) if kill "$pid"; then printf 'SIGTERM %s %s\n' "$pid" "${line#c}"; else status=1; fi ;;
    esac
  done <<< "$records"
  return "$status"
}
# Missing capability: resolve registered tunnel names without allocating on lookup.
# Reuse single-word Bash aliases as device names; never execute alias text.
function __device_name () {
  local name=$1 next
  local -A seen=()
  while [[ ${BASH_ALIASES[$name]+set} ]]; do
    next=${BASH_ALIASES[$name]}
    [[ $next =~ ^[[:alnum:]_@.:-]+$ ]] || break
    [[ ! ${seen[$name]+set} ]] || { echo "Device alias cycle: $1" >&2; return 2; }
    seen[$name]=1; name=$next
  done
  printf '%s\n' "$name"
}
function __tunnel_port () { getport --lookup "$1"; }
function __tunnel_target () {
  local port status device=$2
  if port=$(__tunnel_port "$device"); then printf '127.0.0.1%s%s\n' "$1" "$port"
  else
    status=$?; ((status == 1)) || return "$status"
    if declare -F __lan_resolve_target_token >/dev/null; then __lan_resolve_target_token "$device"
    else printf '%s\n' "$device"; fi
  fi
}

# Shared with the numeric-host shortcut in the user's profile.
function __lan_ssh_option_takes_arg () {
  case "$1" in
    -B|-b|-c|-D|-E|-e|-F|-I|-i|-J|-L|-l|-m|-O|-o|-p|-P|-Q|-R|-S|-W|-w) return 0 ;;
    *) return 1 ;;
  esac
}
function ssh () {
  local -a args=("$@") tunnel_opts=()
  local i=0 n=${#args[@]} target user= port status title
  local device_loaded=${device_loaded-} device_caller=${device_caller-} device_gateway=${device_gateway-} device_endpoint=${device_endpoint-} device_password=${device_password-}
  while ((i < n)); do
    if [[ ${args[i]} == -- ]]; then ((i++)); break; fi
    [[ ${args[i]} == -* ]] || break
    if __lan_ssh_option_takes_arg "${args[i]}" && ((i + 1 < n)); then ((i += 2)); else ((i++)); fi
  done
  if ((i < n)); then
    target=${args[i]}
    [[ $target == *@* ]] && user=${target%@*}@
    target=$(__device_name "${target##*@}") || return
    args[i]="$user$target"
    if __device_read ssh "$target"; then :
    else status=$?; ((status == 1)) || return "$status"; fi
    if [[ -n $device_endpoint ]]; then
      port=$(__device_target : "$target") || return
      args[i]="$user${port%:*}"
      tunnel_opts=(-p "${port##*:}" -o "HostKeyAlias=$target")
    elif port=$(__tunnel_port "${target##*@}"); then
      args[i]="${user}127.0.0.1"
      tunnel_opts=(-p "$port" -o "HostKeyAlias=${target##*@}")
    else
      status=$?; ((status == 1)) || return "$status"
      if declare -F __lan_resolve_target_token >/dev/null; then
        args[i]="$(__lan_resolve_target_token "$user$target")" || return
      fi
    fi
  fi
  if [[ -z ${SSH_CLIENT-} ]] && declare -F __terminal_title >/dev/null; then
    printf -v title '%q ' ssh "$@"
    __terminal_title "${USER}@${HOSTNAME}: ${PWD} - ${title% }"
  fi
  command ssh "${tunnel_opts[@]}" "${args[@]}"
}

# Keep forwards in this foreground SSH connection; its exit closes all listeners.
function sshh () (
  (($# >= 2)) || { echo 'Usage: sshh host [name:][target:]port ...' >&2; return 2; }
  local host=$1 spec name target port key lock state i=0
  local -a names=() targets=() ports=() forwards=()
  local -A seen=()
  [[ $host =~ ^([[:alnum:]_.-]+@)?[[:alnum:]_][[:alnum:]_.-]*$ ]] || { echo "Invalid SSH host: $host" >&2; return 2; }
  shift
  for spec in "$@"; do
    ((i+=1)); name=; target=127.0.0.1
    if [[ $spec =~ ^([[:alnum:]_.-]*):(\[[[:xdigit:]:.]+\]|[[:alnum:]_.-]*):([0-9]{1,5})$ ]]; then
      name=${BASH_REMATCH[1]}; target=${BASH_REMATCH[2]:-127.0.0.1}; port=${BASH_REMATCH[3]}
    elif [[ $spec =~ ^([[:alnum:]_.-]+):([0-9]{1,5})$ ]]; then
      name=${BASH_REMATCH[1]}; port=${BASH_REMATCH[2]}
    elif [[ $spec =~ ^[0-9]{1,5}$ ]]; then port=$spec
    else echo "Invalid forward: $spec" >&2; return 2; fi
    ((10#$port >= 1 && 10#$port <= 65535)) || { echo "Invalid port: $port" >&2; return 2; }
    key=${host##*@}:${name:-$i}
    [[ ! ${seen[$key]+yes} ]] || { echo "Duplicate tunnel name: $key" >&2; return 2; }
    seen[$key]=1; names+=("$key"); targets+=("$target"); ports+=("$((10#$port))")
  done
  # Hold each name for this connection, including the allocation-to-bind window.
  state=${XDG_STATE_HOME:-$HOME/.local/state}/dagelf-utils
  mkdir -p "$state" || return
  for key in "${names[@]}"; do
    exec {lock}>"$state/sshh-$key.lock" || return
    flock -n "$lock" || { echo "Tunnel already active or starting: $key" >&2; return 1; }
  done
  for i in "${!names[@]}"; do
    # Reuse the allocation during setup, before SSH has opened its listener.
    if port=$(getport --lookup "${names[i]}"); then :
    else
      local status=$?; ((status == 1)) || return "$status"
      port=$(getport "${names[i]}") || return
    fi
    forwards+=(-L "127.0.0.1:$port:${targets[i]}:${ports[i]}")
    printf '%s -> 127.0.0.1:%s -> %s:%s\n' "${names[i]}" "$port" "${targets[i]}" "${ports[i]}" >&2
  done
  echo 'sshh: opening forwards; Ctrl-C closes them. Broken connections time out; no automatic reconnect.' >&2
  ssh -N -T -o ControlPath=none -o ControlMaster=no -o ControlPersist=no -o ForkAfterAuthentication=no \
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "${forwards[@]}" -- "$host"
)
